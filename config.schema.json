{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Playbook Scheduler configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "timezone": {
      "type": "string",
      "description": "IANA time zone used by the scheduler."
    },
    "runs_directory": {
      "type": "string"
    },
    "reports_directory": {
      "type": "string"
    },
    "retention_days": {
      "type": "integer",
      "minimum": 1
    },
    "max_parallel_jobs": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum number of different jobs the scheduler runs at the same time."
    },
    "report_output_lines": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of trailing stdout/stderr lines per run shown in the HTML report."
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "cron",
          "playbook",
          "inventory"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "cron": {
            "type": "string",
            "description": "Five-field cron expression."
          },
          "playbook": {
            "type": "string",
            "minLength": 1
          },
          "inventory": {
            "type": "string",
            "minLength": 1
          },
          "working_directory": {
            "type": "string",
            "minLength": 1
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "extra_args": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ansible_venv": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": [
    "jobs"
  ]
}
