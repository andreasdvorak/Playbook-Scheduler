---
extends: default

rules:
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  line-length:
    max: 100
    allow-non-breakable-words: true
    allow-non-breakable-inline-mappings: true
    ignore: |
      # do ignore any files

ignore:
  - .git/
  - .venv/
  - build/
  - dist/
